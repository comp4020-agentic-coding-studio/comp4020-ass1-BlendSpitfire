---
import Layout from "../layouts/Layout.astro";
import { MODES } from "../scripts/modes";

const churchModes = MODES.filter((mode) => mode.group === "church");
const otherScales = MODES.filter((mode) => mode.group === "other");
const pentatonicScales = MODES.filter((mode) => mode.group === "pentatonic");
---

<Layout title="Modes and scales, compared">
  <header>
    <nav aria-label="Primary">
      <a href="#mode-primer">What is a mode</a>
      <a href="#play">Play</a>
    </nav>
  </header>
  <main>
    <h1>Modes and scales, compared</h1>
    <p data-testid="intro">
      Every mode below picks a different subset of the same 12 notes. Click a
      note on the wheel to hear it alone, click a mode to hear a tune written
      for it, or play its full scale.
    </p>

    <details class="mode-primer" id="mode-primer">
      <summary>What is a mode in music?</summary>
      <p>
        A <strong>mode</strong> (or scale) is a specific pattern of whole and
        half steps chosen from the 12 pitches Western music recognizes. Below
        is all 12, with no mode applied — nothing picked out. Every mode
        below, and every scale in music generally, is simply a particular
        subset of these same 12 notes, arranged in a particular order. Click
        any of them to hear the raw pitch.
      </p>
      <div id="baseline-wheel" class="wheel wheel-baseline" data-testid="baseline-wheel"></div>
      <p class="hint">
        The pentatonic scales further down pick just 5 or 6 of these notes,
        not 7 — one reason they sound so different.
      </p>
    </details>

    <section aria-labelledby="wheel-heading" id="play">
      <h2 id="wheel-heading">Play a mode</h2>

      <div class="mode-groups">
        <div class="mode-group">
          <h3>Church modes</h3>
          <div class="mode-buttons" role="group" aria-label="Church modes">
            {
              churchModes.map((mode, index) => (
                <button
                  type="button"
                  data-mode-button={mode.id}
                  aria-pressed={index === 0}
                  style={`--mode-color: ${mode.color}`}
                >
                  {mode.name}
                </button>
              ))
            }
          </div>
        </div>

        <div class="mode-group">
          <h3>Other scales</h3>
          <div class="mode-buttons" role="group" aria-label="Other scales">
            {
              otherScales.map((mode) => (
                <button
                  type="button"
                  data-mode-button={mode.id}
                  aria-pressed={false}
                  style={`--mode-color: ${mode.color}`}
                >
                  {mode.name}
                </button>
              ))
            }
          </div>
        </div>

        <div class="mode-group">
          <h3>Pentatonic scales</h3>
          <div class="mode-buttons" role="group" aria-label="Pentatonic scales">
            {
              pentatonicScales.map((mode) => (
                <button
                  type="button"
                  data-mode-button={mode.id}
                  aria-pressed={false}
                  style={`--mode-color: ${mode.color}`}
                >
                  {mode.name}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div class="mode-panel">
        <div id="mode-label" class="mode-label" data-testid="mode-label"></div>
        <div id="wheel" class="wheel" data-testid="wheel"></div>
        <button type="button" id="play-scale-button" class="scale-button">▶ Hear the full scale</button>
      </div>
      <p class="hint">
        Big circles are the white keys, small ones the black keys. Filled
        circles are this mode's notes; the outlined one is playing now. Click
        any note to hear it alone.
      </p>
    </section>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
